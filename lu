local function ClearAllTracer()
    for _, drawObj in tracerTable do
        if drawObj.Remove then drawObj:Remove() end
    end
    table.clear(tracerTable)
end

-- 生成单条弹道
local function MakeTrace(startPos, endPos)
    local cam = workspace.CurrentCamera
    local p1, on1 = cam:WorldToViewportPoint(startPos)
    local p2, on2 = cam:WorldToViewportPoint(endPos)
    if not on1 and not on2 then return end

    local line = Drawing.new("Line")
    local hue = tick() % 3
    line.From = Vector2.new(p1.X, p1.Y)
    line.To = Vector2.new(p2.X, p2.Y)
    line.Thickness = 2.2
    line.Visible = true
    if _G.TracerRainbowMode then
        line.Color = Color3.fromHSV(hue, 1, 1)
    else
        line.Color = _G.TracerSingleColor
    end
    table.insert(tracerTable, line)
    task.delay(0.07, function()
        pcall(function() line:Remove() end)
    end)
end

